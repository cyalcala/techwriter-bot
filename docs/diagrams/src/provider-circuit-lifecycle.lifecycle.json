    {
      "dot": "emerald",
      "title": "Main Path",
      "items": [
        "Eligible providers are selected by role, attempted, and classified.",
        "A successful response clears failure timestamps and ejection state.",
        "The main rail describes circuit eligibility rather than a service guarantee."
      ]
    },
    {
      "dot": "amber",
      "title": "Human + Input Gates",
      "items": [
        "Three failures in the rolling 60-second window trigger ejection.",
        "Temporary ejection is 30 seconds; a 401 uses a 10-minute path.",
        "Artifact requests can intentionally remain session-locked to a provider."
      ]
    },
    {
      "dot": "rose",
      "title": "Terminal + Recovery",
      "items": [
        "Retryable outcomes can move to another eligible provider.",
        "Permanent credential failure and pool exhaustion are terminal outcomes.",
        "The router records telemetry and persists circuit state when KV is available."
      ]
    }
